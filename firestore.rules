rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catalogul: oricine citește, nimeni nu scrie din browser
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Promoții: oricine citește (ca să vadă reducerile pe site), nimeni nu scrie din browser
match /promotions/{promotionId} {
  allow read: if true;
  allow write: if false;
}

    // Comenzi: oricine poate CREA o comandă (checkout ca invitat),
    // dar structura e validată strict; nimeni nu poate citi/modifica/șterge din browser
    match /orders/{orderId} {
      allow read, update, delete: if false;

      allow create: if
        // câmpurile de nivel 1: exact astea, nimic în plus
        request.resource.data.keys().hasOnly([
          'createdAt', 'currency', 'customer', 'items',
          'paymentMethod', 'status', 'total'
        ]) &&
        request.resource.data.keys().hasAll([
          'createdAt', 'currency', 'customer', 'items',
          'paymentMethod', 'status', 'total'
        ]) &&

        // status și metodă de plată — nu pot fi falsificate la creare
        request.resource.data.status == 'nou' &&
        request.resource.data.paymentMethod == 'ramburs' &&
        request.resource.data.currency == 'RON' &&

        // createdAt trebuie să fie momentul serverului, nu unul inventat
        request.resource.data.createdAt == request.time &&

        // total: număr pozitiv, cu o limită superioară rezonabilă (ex. 500.000 RON = 50.000.000 bani)
        request.resource.data.total is int &&
        request.resource.data.total > 0 &&
        request.resource.data.total < 50000000 &&

        // customer: exact aceste câmpuri, toate string, cu lungimi rezonabile
        request.resource.data.customer.keys().hasOnly([
          'name', 'email', 'phone', 'address', 'city', 'county', 'notes'
        ]) &&
        request.resource.data.customer.keys().hasAll([
          'name', 'email', 'phone', 'address', 'city', 'county'
        ]) &&
        request.resource.data.customer.name is string &&
        request.resource.data.customer.name.size() > 0 &&
        request.resource.data.customer.name.size() < 200 &&
        request.resource.data.customer.email is string &&
        request.resource.data.customer.email.size() > 3 &&
        request.resource.data.customer.email.size() < 200 &&
        request.resource.data.customer.phone is string &&
        request.resource.data.customer.phone.size() < 30 &&
        request.resource.data.customer.address is string &&
        request.resource.data.customer.address.size() < 500 &&
        request.resource.data.customer.city is string &&
        request.resource.data.customer.city.size() < 200 &&
        request.resource.data.customer.county is string &&
        request.resource.data.customer.county.size() < 200 &&

        // items: listă nevidă, cu maxim 30 de produse într-o comandă
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() < 30;
    }
  }
}